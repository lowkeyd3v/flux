# ==============================================================================
# FLUX Production Docker Compose Environment Configuration
# Copy this file to .env before running: docker compose -f docker-compose.prod.yml up -d
# ==============================================================================

# Database Credentials
POSTGRES_USER=flux_user
POSTGRES_PASSWORD=replace_with_strong_production_password_123!
POSTGRES_DB=flux_db

# Ports Mapping
HTTP_PORT=80
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Grafana Dashboard Admin Credentials
GRAFANA_USER=admin
GRAFANA_PASSWORD=replace_with_strong_admin_password_123!

# External API Integrations (Optional)
WEATHER_API_KEY=
LLM_API_KEY=

# Backend Concurrency Tuning
WEB_CONCURRENCY=4
LOG_LEVEL=info
CORS_ORIGINS=https://flux.example.com,http://localhost
