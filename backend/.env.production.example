# ==============================================================================
# FLUX Backend Production Environment Template
# ==============================================================================

APP_NAME="FLUX Production API"
APP_ENV=production
API_V1_PREFIX=/api

# Managed PostgreSQL Connection String (e.g. AWS RDS, Supabase, Neon, Azure)
DATABASE_URL=postgresql+psycopg2://flux_admin:STRONG_PASSWORD_HERE@db.prod.flux.internal:5432/flux_production?sslmode=require

# Allowed CORS Origins (Comma-separated production domains & CDN URLs)
CORS_ORIGINS=https://flux.example.com,https://app.flux.org.in

# OpenWeatherMap API Key for Live Vendor Forecasts
WEATHER_API_KEY=

# OpenAI / Gemini API Key for Grounded Scheme Conversational Synthesis
LLM_API_KEY=

# Gunicorn / Uvicorn ASGI Worker Tuning
WEB_CONCURRENCY=4
LOG_LEVEL=info
